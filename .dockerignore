# ============================================================
# .dockerignore — 排除 Docker 构建上下文中的无关文件
# ============================================================

# Git
.git
.gitignore

# 虚拟环境（Docker 容器内会重新 pip install）
venv/
!venv/.keep

# Python 缓存 & 编译
__pycache__
*.py[cod]
*$py.class
*.so

# IDE
.vscode/
.idea/
.claude/
.workbuddy/
*.swp
*.swo

# 测试
.pytest_cache/
htmlcov/
.coverage
.tox/

# 日志 & 临时文件
*.log
logs/
*.sqlite3
*.sqlite3-journal
media/

# 环境变量（通过 docker-compose env_file 注入）
.env
.env.local

# 非项目文件（保留 .env.example、README.md）

# Docker 自身
Dockerfile
docker-compose.yml
.dockerignore

# OS
.DS_Store
Thumbs.db

# Redis 持久化
dump.rdb

# Celery
celerybeat-schedule
var/

# 面试资料（不需要进容器）
面试专用对策.md

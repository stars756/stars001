# ============================================================
# BaykeShop 环境变量配置模板
#
# 使用方法：cp .env.example .env，然后修改以下值
# 注意：.env 文件已被 .gitignore 排除，不会提交到版本控制
# ============================================================

# ---- 数据库配置 ----
POSTGRES_USER=baykeuser
POSTGRES_PASSWORD=请修改为强密码
POSTGRES_DB=baykeshop
POSTGRES_PORT=5432

# ---- Redis 配置 ----
REDIS_PORT=6379

# ---- Web 服务端口 ----
WEB_PORT=8000

# ---- Django 核心配置 ----
SECRET_KEY=请生成一个随机密钥（python -c "import secrets; print(secrets.token_urlsafe(50))"）
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ---- 邮件配置（开发环境用 ConsoleBackend 可不填） ----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_SUBJECT_PREFIX=[baykeShop]

# ---- 支付宝沙箱配置 ----
ALIPAY_APP_ID=your_sandbox_app_id
ALIPAY_PRIVATE_KEY=your_private_key
ALIPAY_PUBLIC_KEY=alipay_public_key

# ---- Gunicorn 工作进程数（建议 CPU核数 * 2 + 1） ----
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ---- Celery Worker 并发数 ----
CELERY_CONCURRENCY=4

# ---- 域名配置（生产环境使用） ----
DOMAIN_NAME=localhost

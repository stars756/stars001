# ============================================================
# BaykeShop 环境变量配置模板
# .env 已被 .gitignore 排除，不会提交到版本控制
# ============================================================

# ---- Django 核心 ----
SECRET_KEY=请生成随机密钥: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL 数据库 ----
DB_NAME=shop_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ---- Redis 连接 ----
REDIS_URL=redis://127.0.0.1:6379

# ---- 邮件 SMTP (开发环境使用 ConsoleBackend 可不填) ----
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=False

# ---- 支付宝沙箱环境 (DEBUG=True 时使用) ----
ALIPAY_SANDBOX_APPID=
ALIPAY_SANDBOX_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=

# ---- 支付宝生产环境 (DEBUG=False 时使用) ----
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---- Celery Worker 并发数 ----
CELERY_CONCURRENCY=4

# ---- Celery 调试 (开发环境可开启同步执行) ----
# CELERY_ALWAYS_EAGER=True

# ---- Gunicorn (生产 WSGI 服务器) ----
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4

# ---- Web 服务端口 ----
# WEB_PORT=8000

# ---- PostgreSQL 容器配置 (docker-compose 使用) ----
# POSTGRES_USER=baykeuser
# POSTGRES_PASSWORD=baykepass123
# POSTGRES_DB=baykeshop
# POSTGRES_PORT=5432

# ---- Redis 容器端口 ----
# REDIS_PORT=6379

# ---- Flower 监控面板认证 (生产环境必须修改) ----
# FLOWER_BASIC_AUTH=admin:changeme
